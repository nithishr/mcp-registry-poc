{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.nithishr/mcp-multi-poc-beta",
  "description": "PoC beta server - extras-gated deps, subcommand selection, same PyPI package as alpha.",
  "repository": {
    "url": "https://github.com/nithishr/mcp-registry-poc",
    "source": "github"
  },
  "version": "0.1.0",
  "packages": [
    {
      "registryType": "pypi",
      "identifier": "mcp-multi-poc[beta]",
      "version": "0.1.0",
      "transport": {
        "type": "stdio"
      },
      "packageArguments": [
        {
          "type": "positional",
          "value": "beta",
          "valueHint": "beta",
          "description": "Run the beta MCP server (requires the beta extra)",
          "isRequired": true
        }
      ]
    }
  ]
}
