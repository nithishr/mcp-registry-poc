{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.nithishr/mcp-multi-poc-alpha",
  "description": "PoC alpha server - base install, subcommand selection from a shared PyPI package.",
  "repository": {
    "url": "https://github.com/nithishr/mcp-registry-poc",
    "source": "github"
  },
  "version": "0.1.0",
  "packages": [
    {
      "registryType": "pypi",
      "identifier": "mcp-multi-poc",
      "version": "0.1.0",
      "transport": {
        "type": "stdio"
      },
      "packageArguments": [
        {
          "type": "positional",
          "value": "alpha",
          "valueHint": "alpha",
          "description": "Run the alpha MCP server",
          "isRequired": true
        }
      ]
    }
  ]
}
